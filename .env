# =============================================================================
# OPENWRT BUILDER WRAPPER - GLOBAL ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# This file defines project-wide configuration defaults. It is mounted into
# the build container as /builder/.env, where the build script (build.sh)
# reads it as the global value source.
#
# Effective precedence for any variable, from highest to lowest:
#   1. Command-line environment variables / inline assignments, e.g.
#      BW_MAIN_LAN_IP=192.168.2.1 ./run.sh --image=...
#   2. The module's own .env file (modules/<name>/.env)
#   3. This global .env file
#
# NOTE: A module's .env.example file is for variable discovery ONLY and is
# never a value source. Keep real defaults here or in the module's .env.
# =============================================================================

# --- Logging control --------------------------------------------------------
# Enables or disables log output inside the Docker container.
# (1: Enabled, 0: Disabled)
BW_LOG_ENABLE=1

# --- Debug prints control ---------------------------------------------------
# Enables verbose debug output (only effective when BW_LOG_ENABLE=1).
# (1: Enabled, 0: Disabled)
BW_DEBUG=0
