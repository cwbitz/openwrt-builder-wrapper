# Configuration template for the 'lan' module.
# You can set these environment variables using either of the following methods:
# 1. Create a '.env' file in this module directory and copy the variables below into it.
# 2. Pass them directly when executing run.sh (e.g. BW_LAN_IP=192.168.2.1 ./run.sh ...)

# LAN Network Configuration
# Set the static IP address for the LAN interface (default: 192.168.2.1)
BW_LAN_IP=192.168.2.1
