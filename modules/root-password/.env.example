# Configuration template for the 'root-password' module.
# You can set these environment variables using either of the following methods:
# 1. Create a '.env' file in this module directory and copy the variables below into it.
# 2. Pass them directly when executing run.sh (e.g. BW_ROOT_PASSWORD=secret ./run.sh ...)

# Root User Password Configuration
# Set the administrator (root) login password for OpenWrt
BW_ROOT_PASSWORD=
